{
  "name": "lightsail-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-lightsail": "^3.800.0",
    "@aws-sdk/credential-providers": "^3.800.0",
    "dotenv": "^16.5.0",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
